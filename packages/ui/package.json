{
  "name": "@irisui/ui",
  "version": "0.1.0",
  "description": "Accessible React components in the Verre irisé style.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme-script": {
      "import": {
        "types": "./dist/theme-script.d.ts",
        "default": "./dist/theme-script.js"
      },
      "require": {
        "types": "./dist/theme-script.d.cts",
        "default": "./dist/theme-script.cjs"
      }
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@irisui/tokens": "workspace:*",
    "@irisui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theteqlab/iris-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/theteqlab/iris-ui#readme",
  "bugs": {
    "url": "https://github.com/theteqlab/iris-ui/issues"
  }
}
