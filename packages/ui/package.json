{
  "name": "@irisui/ui",
  "version": "0.2.0",
  "description": "Accessible React components in the Verre irisé style.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "src/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./theme-script": {
      "import": {
        "types": "./dist/theme-script.d.ts",
        "default": "./dist/theme-script.js"
      },
      "require": {
        "types": "./dist/theme-script.d.cts",
        "default": "./dist/theme-script.cjs"
      }
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@irisui/tokens": "workspace:*",
    "@irisui/utils": "workspace:*",
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-radio-group": "1.4.8",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-tabs": "1.1.22",
    "@radix-ui/react-tooltip": "1.3.0",
    "tailwind-variants": "3.3.1"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theteqlab/iris-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/theteqlab/iris-ui#readme",
  "bugs": {
    "url": "https://github.com/theteqlab/iris-ui/issues"
  }
}
