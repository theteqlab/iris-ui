{
  "name": "iris-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=playground",
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=docs...",
    "typecheck": "turbo run typecheck",
    "contrast": "node scripts/check-contrast.ts",
    "rename-scope": "node scripts/rename-scope.ts",
    "changeset": "changeset",
    "format": "prettier --write --ignore-unknown \"{apps,packages,scripts,test,e2e,.github,.changeset}/**\" \"*.{js,ts,json,yaml,yml}\" README.md",
    "format:check": "prettier --check --ignore-unknown \"{apps,packages,scripts,test,e2e,.github,.changeset}/**\" \"*.{js,ts,json,yaml,yml}\" README.md",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
